# Bot
PORT=3000

# Monad RPC. Public is fine for dry-run. Dedicated for live.
RPC_URL=https://rpc.monad.xyz
READ_RPC_URL=https://rpc.monad.xyz
WS_URL=wss://rpc.monad.xyz

# Market
MARKET=0x065C9d28E428A0db40191a54d33d5b7c71a9C394
MARGIN_ACCOUNT=0x2A68ba1833cDf93fa9Da1EEbd7F46242aD8E90c5

# Never set PRIVATE_KEY on Fly for v1.
PRIVATE_KEY=
DRY_RUN=true

# mock | luna | jev
MODEL=mock
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest
LUNA_API_KEY=
LUNA_BASE_URL=
LUNA_MODEL=

# Directional paper execution
STRATEGY=cex_lag
DIRECTIONAL_SIZE_MON=500
MIN_DIRECTIONAL_SIZE_MON=500
MAX_DIRECTIONAL_SIZE_MON=250000
MIN_PAPER_LEVERAGE=5
MAX_PAPER_LEVERAGE=50
TRAIL_ACTIVATION_BPS=12
TRAIL_GIVEBACK_BPS=6
CEX_MAX_HOLD_MS=90000
MEAN_REVERSION_MAX_HOLD_MS=300000
BANKROLL_USD=100
MAX_LOSS_USD=25
HORIZON_BLOCKS=100
PAPER_TAKER_FEE_BPS=0
PAPER_SLIPPAGE_BPS=0
MIN_EXPECTED_EDGE_BPS=5

# Liquid MON reference and funding. Defaults use Gate MON_USDT futures.
REFERENCE_URL=https://api.gateio.ws/api/v4/futures/usdt/tickers?contract=MON_USDT
FUNDING_URL=https://api.gateio.ws/api/v4/futures/usdt/tickers?contract=MON_USDT
REFERENCE_WS_URL=wss://fx-ws.gateio.ws/v4/ws/usdt
REFERENCE_POLL_MS=1000
REFERENCE_STALE_MS=5000
REFERENCE_RETURN_WINDOW_MS=1000
REFERENCE_IMPULSE_BPS=2
